# Copy to ".env" and adjust. Every value is optional; the defaults are shown.
# The Settings page can also write these values for you (restart afterwards).
# Variables are read from the process environment (and from .env if present);
# real environment variables win over this file.

# Base folder for the database, logs, screenshots, backups and exports.
# Relative paths are resolved against the project root.
SJAT_DATA_DIR=data

# Optional separate locations (default: inside SJAT_DATA_DIR).
# SJAT_DATABASE_FILE=data/sjat.db
# SJAT_LOGS_DIR=data/logs
# SJAT_SCREENSHOTS_DIR=data/screenshots

# Ports of the local, controlled test servers (bound to 127.0.0.1 only).
# Use 1024-65535; the two ports must differ.
SJAT_SEARCH_PORT=8765
SJAT_TARGET_PORT=8766

# DEBUG, INFO, WARNING or ERROR
SJAT_LOG_LEVEL=INFO
